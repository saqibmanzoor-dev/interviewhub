# ===============================================
# InterviewHub — Environment Configuration Template
# ===============================================

# Server Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/interviewhub

# Authentication Secrets (Replace in production with secure 64-char keys)
JWT_ACCESS_SECRET=interviewhub_jwt_access_secret_super_secure_key_prod_2026
JWT_REFRESH_SECRET=interviewhub_jwt_refresh_secret_key_prod_fallback
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth 2.0 Credentials (Optional: simulated OAuth active if not supplied)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# WebRTC STUN/TURN Media Relay Configuration
STUN_SERVER=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Code Execution Engine (Optional remote Piston endpoint, built-in Node VM fallback active)
CODE_EXECUTION_API_URL=
CODE_EXECUTION_API_KEY=

# Email Dispatcher (Optional SMTP credentials)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="InterviewHub Team" <no-reply@interviewhub.io>

# Client Environment (Vite variables)
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000
