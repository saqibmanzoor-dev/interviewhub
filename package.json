{
  "name": "interviewhub",
  "version": "1.0.0",
  "description": "Real-Time Technical Interview Platform inspired by Google Meet, HackerRank, and Social Blade",
  "main": "server/src/server.js",
  "type": "module",
  "scripts": {
    "start": "node server/src/server.js",
    "server": "node --watch server/src/server.js",
    "client": "npm --prefix client run dev",
    "postinstall": "npm --prefix client install",
    "build": "npm --prefix client run build",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,magenta.bold\" \"npm run server\" \"npm run client\"",
    "seed": "node server/src/utils/seed.js",
    "test": "npm --prefix server test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "nodemailer": "^10.2.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "peerjs": "^1.5.5",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
